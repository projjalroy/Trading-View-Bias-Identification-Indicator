//@version=6
indicator("ICT Daily Bias | ERL-IRL + MTF MSS", shorttitle="ICT Bias", overlay=true, max_labels_count=200, max_lines_count=100)

// =====================================================================
//  ICT DAILY BIAS  (v2 - works from any chart timeframe)
//  Liquidity timeframe (default Daily) -> ERL / IRL map
//  Mid timeframe (auto-aligned, default H1) -> MSS confirmation
//
//  Alignment (default):  Weekly -> H4 | Daily -> H1 | H4 -> 15m | H1 -> 5m
//
//  ERL > IRL : external liquidity swept (prev high/low, swing, prev week)
//              -> expect a move into an internal array (FVG / equilibrium)
//  IRL > ERL : internal array (Daily FVG) tapped and rejected
//              -> expect a move to the next external liquidity (swing first)
//  Bias is only CONFIRMED when the aligned MTF prints a closed-candle MSS
//  with displacement in the expected direction.
//
//  If the chart timeframe is ABOVE the MTF (e.g. Daily chart, H1 MTF) the
//  script reads the MTF intrabars directly, so you can keep the Daily chart.
//  Only CLOSED MTF bars are used (no repainting).
// =====================================================================

// ───────────────────────── Inputs ─────────────────────────
liqTf       = input.string("D", "Liquidity timeframe (where the sweep is read)", options=["W", "D", "240", "60"], group="Timeframe alignment", tooltip="Auto MTF: W>H4, D>H1, H4>15m, H1>5m")
mtfOverride = input.timeframe("", "MTF override (blank = auto)", group="Timeframe alignment")

liqPiv      = input.int(3, "Swing length - liquidity TF", minval=1, group="Structure")
mtfPiv      = input.int(2, "Swing length - MTF", minval=1, group="Structure")
atrLen      = input.int(14, "ATR length (MTF)", minval=1, group="Structure")
dispMult    = input.float(1.0, "MSS displacement: candle body >= ATR x", minval=0.0, step=0.1, group="Structure")

inclWeekly  = input.bool(true, "Include previous-week high/low as ERL", group="Liquidity")
pdFilter    = input.bool(false, "Premium/discount filter on IRL taps", group="Liquidity")
maxAge      = input.int(5, "Pending bias expires after (liquidity bars)", minval=1, group="Liquidity")

showLevels  = input.bool(true, "Plot levels", group="Display")
showTable   = input.bool(true, "Show bias table", group="Display")
showLabels  = input.bool(true, "Show event labels", group="Display")
showBg      = input.bool(true, "Tint background when confirmed", group="Display")
colBull     = input.color(#26a69a, "Bullish colour", group="Display")
colBear     = input.color(#ef5350, "Bearish colour", group="Display")

// ───────────────────────── Derived settings ─────────────────────────
autoMtf = switch liqTf
    "W"   => "240"
    "D"   => "60"
    "240" => "15"
    =>       "5"

liqName = switch liqTf
    "W"   => "Weekly"
    "D"   => "Daily"
    "240" => "H4"
    =>       "H1"

mtfTf     = mtfOverride == "" ? autoMtf : mtfOverride
useWeekly = inclWeekly and liqTf != "W"
mtfSec    = timeframe.in_seconds(mtfTf)
lowerMode = timeframe.in_seconds() > mtfSec                      // chart above MTF -> read intrabars
warnTf    = timeframe.in_seconds() > timeframe.in_seconds(liqTf) // chart above liquidity TF -> not supported

// ───────────────────────── Data functions ─────────────────────────
// Liquidity timeframe: previous completed bar high/low, last confirmed swings,
// latest unmitigated bullish / bearish FVG. Returned [1] = completed bar values.
f_liq(int n) =>
    ph = ta.pivothigh(high, n, n)
    pl = ta.pivotlow(low, n, n)
    var float sh   = na
    var float sl   = na
    var float bTop = na
    var float bBot = na
    var float sTop = na
    var float sBot = na
    if not na(ph)
        sh := ph
    if not na(pl)
        sl := pl
    if low > high[2]
        bTop := low
        bBot := high[2]
    if high < low[2]
        sTop := low[2]
        sBot := high
    if not na(bBot) and close < bBot
        bTop := na
        bBot := na
    if not na(sTop) and close > sTop
        sTop := na
        sBot := na
    [high[1], low[1], sh[1], sl[1], bTop[1], bBot[1], sTop[1], sBot[1]]

// MTF values for the CURRENT bar (used with request.security_lower_tf)
f_mtfNow(int n, int len) =>
    ph = ta.pivothigh(high, n, n)
    pl = ta.pivotlow(low, n, n)
    var float sh = na
    var float sl = na
    if not na(ph)
        sh := ph
    if not na(pl)
        sl := pl
    a = ta.atr(len)
    [time, open, high, low, close, sh, sl, a]

// MTF values for the last CLOSED bar (used when chart TF <= MTF)
f_mtf(int n, int len) =>
    ph = ta.pivothigh(high, n, n)
    pl = ta.pivotlow(low, n, n)
    var float sh = na
    var float sl = na
    if not na(ph)
        sh := ph
    if not na(pl)
        sl := pl
    a = ta.atr(len)
    [time[1], open[1], high[1], low[1], close[1], sh[1], sl[1], a[1]]

// Target / draw on liquidity.
// kind 1 (ERL>IRL): nearest internal array in the bias direction (FVG or equilibrium)
// kind 2 (IRL>ERL): external liquidity in the bias direction - swing high/low first,
//                   otherwise the nearest of previous high/low and previous week
f_target(int d, int k, float px, float eq, float bullZoneTop, float bearZoneBot, float sh, float sl, float pdh, float pdl, float pwh, float pwl) =>
    float t = na
    string n = "-"
    if d == -1 and k == 1
        if not na(bullZoneTop) and bullZoneTop < px
            t := bullZoneTop
            n := "Bull FVG"
        if not na(eq) and eq < px and (na(t) or eq > t)
            t := eq
            n := "Equilibrium"
        if na(t) and not na(sl) and sl < px
            t := sl
            n := "Range low"
    else if d == 1 and k == 1
        if not na(bearZoneBot) and bearZoneBot > px
            t := bearZoneBot
            n := "Bear FVG"
        if not na(eq) and eq > px and (na(t) or eq < t)
            t := eq
            n := "Equilibrium"
        if na(t) and not na(sh) and sh > px
            t := sh
            n := "Range high"
    else if d == 1 and k == 2
        if not na(sh) and sh > px
            t := sh
            n := "Swing high"
        if na(t) and not na(pdh) and pdh > px
            t := pdh
            n := "Prev high"
        if not na(pwh) and pwh > px and (na(t) or pwh < t)
            t := pwh
            n := "Prev week high"
    else if d == -1 and k == 2
        if not na(sl) and sl < px
            t := sl
            n := "Swing low"
        if na(t) and not na(pdl) and pdl < px
            t := pdl
            n := "Prev low"
        if not na(pwl) and pwl < px and (na(t) or pwl > t)
            t := pwl
            n := "Prev week low"
    [t, n]

f_fresh(float lvl, float consumed) =>
    not na(lvl) and (na(consumed) or lvl != consumed)

// ───────────────────────── Data requests ─────────────────────────
[pdh, pdl, lSH, lSL, bzT, bzB, szT, szB] = request.security(syminfo.tickerid, liqTf, f_liq(liqPiv), lookahead = barmerge.lookahead_on)
[wkH, wkL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[mT, mO, mH, mL, mC, mSH, mSL, mATR] = request.security(syminfo.tickerid, mtfTf, f_mtf(mtfPiv, atrLen), lookahead = barmerge.lookahead_on)

float pwh = useWeekly ? wkH : na
float pwl = useWeekly ? wkL : na
float eq  = (not na(lSH) and not na(lSL)) ? (lSH + lSL) / 2 : na

// MTF bars to process on this chart bar (arrays, oldest first)
array<int>   aT  = array.new<int>()
array<float> aO  = array.new<float>()
array<float> aH  = array.new<float>()
array<float> aL  = array.new<float>()
array<float> aC  = array.new<float>()
array<float> aSH = array.new<float>()
array<float> aSL = array.new<float>()
array<float> aAT = array.new<float>()

bool newMtf = not na(mT) and mT != nz(mT[1])

if lowerMode
    [t1, o1, h1, l1, c1, sh1, sl1, at1] = request.security_lower_tf(syminfo.tickerid, mtfTf, f_mtfNow(mtfPiv, atrLen))
    if not na(t1)
        aT  := t1
        aO  := o1
        aH  := h1
        aL  := l1
        aC  := c1
        aSH := sh1
        aSL := sl1
        aAT := at1
else if newMtf
    aT  := array.from(mT)
    aO  := array.from(mO)
    aH  := array.from(mH)
    aL  := array.from(mL)
    aC  := array.from(mC)
    aSH := array.from(mSH)
    aSL := array.from(mSL)
    aAT := array.from(mATR)

// ───────────────────────── State ─────────────────────────
var int    dir     = 0      // +1 bullish, -1 bearish
var int    status  = 0      // 0 none, 1 pending MSS, 2 confirmed, 3 invalidated, 4 target reached
var int    kind    = 0      // 1 = ERL>IRL, 2 = IRL>ERL
var float  inval   = na
var float  tgt     = na
var string tgtName = "-"
var string evtTxt  = "Waiting for ERL sweep / IRL tap"
var int    evtTime = na
var float  mssLvl  = na

// levels already swept / zones already tapped (prevents re-triggering)
var float cPDH = na
var float cSH  = na
var float cPWH = na
var float cPDL = na
var float cSL  = na
var float cPWL = na
var float cBZ  = na
var float cSZ  = na

bool fEvent    = false
bool fConfBull = false
bool fConfBear = false
bool fInval    = false

// ───────────────────────── Engine (runs once per CLOSED MTF bar) ─────────────────────────
int cnt = na(aT) ? 0 : array.size(aT)

if cnt > 0
    for i = 0 to cnt - 1
        int   bT  = array.get(aT, i)
        float bO  = array.get(aO, i)
        float bH  = array.get(aH, i)
        float bL  = array.get(aL, i)
        float bC  = array.get(aC, i)
        float bSH = array.get(aSH, i)
        float bSL = array.get(aSL, i)
        float bAT = array.get(aAT, i)

        // skip the still-forming MTF bar
        if lowerMode and bT + mtfSec * 1000 > timenow
            continue
        if na(bH) or na(bL) or na(bC)
            continue

        // 1) fresh external liquidity taken on this MTF bar?
        bool sH = false
        bool sL = false
        string hiN = ""
        string loN = ""

        if f_fresh(pdh, cPDH) and bH > pdh
            sH := true
            hiN := "Prev " + liqName + " high"
        if f_fresh(lSH, cSH) and bH > lSH
            sH := true
            hiN := hiN == "" ? liqName + " swing high" : hiN
        if f_fresh(pwh, cPWH) and bH > pwh
            sH := true
            hiN := hiN == "" ? "Prev week high" : hiN

        if f_fresh(pdl, cPDL) and bL < pdl
            sL := true
            loN := "Prev " + liqName + " low"
        if f_fresh(lSL, cSL) and bL < lSL
            sL := true
            loN := loN == "" ? liqName + " swing low" : loN
        if f_fresh(pwl, cPWL) and bL < pwl
            sL := true
            loN := loN == "" ? "Prev week low" : loN

        // 2) fresh tap of an internal array (unmitigated liquidity-TF FVG)?
        bool canBear = not (dir == -1 and status == 2)
        bool canBull = not (dir == 1 and status == 2)
        bool bearEvt = sH and not sL and canBear
        bool bullEvt = sL and not sH and canBull
        bool bullTap = false
        bool bearTap = false
        if not (sH or sL)
            bullTap := f_fresh(bzB, cBZ) and bL <= bzT and bC > bzB and canBull and (not pdFilter or (not na(eq) and (bzT + bzB) / 2 < eq))
            bearTap := f_fresh(szB, cSZ) and bH >= szB and bC < szT and canBear and (not pdFilter or (not na(eq) and (szT + szB) / 2 > eq))
            if bullTap and bearTap
                bearTap := false

        // 3) consume swept levels / tapped zones
        if not na(pdh) and bH > pdh
            cPDH := pdh
        if not na(lSH) and bH > lSH
            cSH := lSH
        if not na(pwh) and bH > pwh
            cPWH := pwh
        if not na(pdl) and bL < pdl
            cPDL := pdl
        if not na(lSL) and bL < lSL
            cSL := lSL
        if not na(pwl) and bL < pwl
            cPWL := pwl
        if not na(bzT) and bL <= bzT
            cBZ := bzB
        if not na(szB) and bH >= szB
            cSZ := szB

        // 4) set a new event
        bool newlySet = false
        if bearEvt
            dir := -1
            kind := 1
            status := 1
            inval := bH
            evtTime := bT
            evtTxt := "ERL swept: " + hiN
            newlySet := true
        else if bullEvt
            dir := 1
            kind := 1
            status := 1
            inval := bL
            evtTime := bT
            evtTxt := "ERL swept: " + loN
            newlySet := true
        else if bullTap
            dir := 1
            kind := 2
            status := 1
            inval := bL
            evtTime := bT
            evtTxt := "IRL tapped: " + liqName + " bull FVG"
            newlySet := true
        else if bearTap
            dir := -1
            kind := 2
            status := 1
            inval := bH
            evtTime := bT
            evtTxt := "IRL tapped: " + liqName + " bear FVG"
            newlySet := true

        [tT, tN] = f_target(dir, kind, bC, eq, bzT, szB, lSH, lSL, pdh, pdl, pwh, pwl)

        if newlySet
            tgt := tT
            tgtName := tN
            fEvent := true
            if showLabels
                label.new(bar_index, dir == 1 ? low : high, (kind == 1 ? "ERL>IRL" : "IRL>ERL") + (dir == 1 ? " bull" : " bear"), style = dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(dir == 1 ? colBull : colBear, 20), textcolor = color.white, size = size.small)

        // 5) pending -> confirmed / invalidated / expired ; confirmed -> invalidated / target
        if status == 1
            bool failed  = not newlySet and ((dir == -1 and bC > inval) or (dir == 1 and bC < inval))
            bool expired = not newlySet and not na(evtTime) and (bT - evtTime) > maxAge * timeframe.in_seconds(liqTf) * 1000
            if failed
                status := 3
                fInval := true
            else if expired
                status := 0
                dir := 0
                evtTxt := "Expired - waiting for ERL sweep / IRL tap"
            else
                if dir == -1
                    inval := math.max(inval, bH)
                else
                    inval := math.min(inval, bL)
                bool disp = math.abs(bC - bO) >= dispMult * bAT
                bool mss  = dir == -1 ? (not na(bSL) and bC < bSL and disp) : (not na(bSH) and bC > bSH and disp)
                if mss
                    status := 2
                    mssLvl := dir == -1 ? bSL : bSH
                    tgt := tT
                    tgtName := tN
                    if dir == 1
                        fConfBull := true
                    else
                        fConfBear := true
                    if showLabels
                        label.new(bar_index, dir == 1 ? low : high, "MSS " + mtfTf + (dir == 1 ? " ▲" : " ▼"), style = dir == 1 ? label.style_label_up : label.style_label_down, color = dir == 1 ? colBull : colBear, textcolor = color.white, size = size.small)
                        if not na(evtTime)
                            line.new(evtTime, mssLvl, bT, mssLvl, xloc = xloc.bar_time, color = dir == 1 ? colBull : colBear, width = 1, style = line.style_dashed)
        else if status == 2
            if (dir == -1 and bC > inval) or (dir == 1 and bC < inval)
                status := 3
                fInval := true
            else if not na(tgt) and ((dir == -1 and bL <= tgt) or (dir == 1 and bH >= tgt))
                status := 4

// ───────────────────────── Plots ─────────────────────────
plot(showLevels ? pdh : na, "Prev high (liquidity TF)", color = color.new(colBear, 30), style = plot.style_linebr, linewidth = 1)
plot(showLevels ? pdl : na, "Prev low (liquidity TF)", color = color.new(colBull, 30), style = plot.style_linebr, linewidth = 1)
plot(showLevels ? pwh : na, "Prev week high", color = color.new(colBear, 60), style = plot.style_linebr, linewidth = 1)
plot(showLevels ? pwl : na, "Prev week low", color = color.new(colBull, 60), style = plot.style_linebr, linewidth = 1)
plot(showLevels ? eq : na, "Equilibrium (50%)", color = color.new(color.gray, 20), style = plot.style_linebr, linewidth = 1)

bgcolor(showBg and status == 2 ? color.new(dir == 1 ? colBull : colBear, 93) : na)

// ───────────────────────── Table ─────────────────────────
var table tb = table.new(position.top_right, 2, 7, border_width = 1, frame_color = color.gray, border_color = color.gray)

if barstate.islast and showTable
    bool live = status == 1 or status == 2
    color bc = live ? (dir == 1 ? colBull : colBear) : color.gray
    string biasTxt = live ? (dir == 1 ? "BULLISH" : "BEARISH") : "NEUTRAL"
    string stTxt = switch status
        0 => "Waiting for sweep / IRL tap"
        1 => "Pending - need " + mtfTf + " MSS"
        2 => "Confirmed by " + mtfTf + " MSS"
        3 => "Invalidated"
        =>   "Target reached"
    string tgtTxt = (live or status == 4) and not na(tgt) ? tgtName + " @ " + str.tostring(tgt, format.mintick) : "-"
    string invTxt = live and not na(inval) ? str.tostring(inval, format.mintick) : "-"
    string chkTxt = warnTf ? "Chart TF is above the liquidity TF - lower it" : (lowerMode ? "OK - reading " + mtfTf + " intrabars" : "OK")

    table.cell(tb, 0, 0, "Bias (" + liqName + ")", text_color = color.white, bgcolor = #2a2e39, text_halign = text.align_left)
    table.cell(tb, 1, 0, biasTxt, text_color = color.white, bgcolor = bc, text_halign = text.align_left)
    table.cell(tb, 0, 1, "Status", text_color = color.white, bgcolor = #2a2e39, text_halign = text.align_left)
    table.cell(tb, 1, 1, stTxt, text_color = color.white, bgcolor = #1e222d, text_halign = text.align_left)
    table.cell(tb, 0, 2, "Last event", text_color = color.white, bgcolor = #2a2e39, text_halign = text.align_left)
    table.cell(tb, 1, 2, evtTxt, text_color = color.white, bgcolor = #1e222d, text_halign = text.align_left)
    table.cell(tb, 0, 3, "Alignment", text_color = color.white, bgcolor = #2a2e39, text_halign = text.align_left)
    table.cell(tb, 1, 3, liqName + " > MTF " + mtfTf, text_color = color.white, bgcolor = #1e222d, text_halign = text.align_left)
    table.cell(tb, 0, 4, "Target", text_color = color.white, bgcolor = #2a2e39, text_halign = text.align_left)
    table.cell(tb, 1, 4, tgtTxt, text_color = color.white, bgcolor = #1e222d, text_halign = text.align_left)
    table.cell(tb, 0, 5, "Invalidation", text_color = color.white, bgcolor = #2a2e39, text_halign = text.align_left)
    table.cell(tb, 1, 5, invTxt, text_color = color.white, bgcolor = #1e222d, text_halign = text.align_left)
    table.cell(tb, 0, 6, "Check", text_color = color.white, bgcolor = #2a2e39, text_halign = text.align_left)
    table.cell(tb, 1, 6, chkTxt, text_color = color.white, bgcolor = warnTf ? color.orange : #1e222d, text_halign = text.align_left)

// ───────────────────────── Alerts ─────────────────────────
alertcondition(fEvent, "ICT Bias: liquidity event", "ICT Bias: ERL sweep or IRL tap detected on {{ticker}}")
alertcondition(fConfBull, "ICT Bias: bullish confirmed", "ICT Bias: BULLISH confirmed by MTF MSS on {{ticker}}")
alertcondition(fConfBear, "ICT Bias: bearish confirmed", "ICT Bias: BEARISH confirmed by MTF MSS on {{ticker}}")
alertcondition(fInval, "ICT Bias: invalidated", "ICT Bias: bias invalidated on {{ticker}}")
